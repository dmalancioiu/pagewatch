# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PageWatch"

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Resend (email alerts) ────────────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM_DOMAIN=yourdomain.com

# ─── Stripe ──────────────────────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# Run: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# One recurring price per self-serve paid plan. The prices shown in the app come
# from lib/plans.ts — create Stripe prices that match those numbers.
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_BUSINESS_PRICE_ID=price_xxxxx
STRIPE_AGENCY_PRICE_ID=price_xxxxx

# ─── Trigger.dev ─────────────────────────────────────────────────────────────
# trigger.dev → Project → API Keys / Settings
TRIGGER_SECRET_KEY=your_trigger_secret_key

# ─── Slack (alert delivery, Pro plan and above) ───────────────────────────────
# All optional — Slack delivery stays "not configured" in the UI, and nothing
# else breaks, until every one of these is set.
# api.slack.com/apps → your app → OAuth & Permissions
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
# api.slack.com/apps → your app → Basic Information → App Credentials.
# Verifies that requests to /api/slack/interactions really came from Slack.
SLACK_SIGNING_SECRET=your_slack_signing_secret
# Register this redirect URL in Slack under OAuth & Permissions:
#   {NEXT_PUBLIC_APP_URL}/api/slack/callback
# Requested scopes: chat:write, chat:write.public
